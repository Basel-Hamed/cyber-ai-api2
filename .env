# App Configuration
APP_NAME=Cyber AI Assistant
APP_VERSION=3.0.0
DEBUG=False
ENVIRONMENT=production

# Server (Render sets PORT automatically)
HOST=0.0.0.0

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-in-production
API_KEYS=test-key,dev-key,admin-key

# Database
DATABASE_URL=sqlite:///./data/cyberai.db

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT=100/minute

# Scraper Settings
SCRAPER_TIMEOUT=10
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY=1.0

# AI Settings
USE_ADVANCED_AI=true
MAX_KEYWORDS=5

# Translation
DEFAULT_LANGUAGE=bn
TRANSLATION_CACHE_SIZE=1000

# Image Analysis
MAX_IMAGE_SIZE=10485760  # 10MB
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/jpg,image/gif,image/bmp

# Chat History
MAX_HISTORY_PER_SESSION=50
STORAGE_TYPE=sqlite

# Logging
LOG_LEVEL=INFO
